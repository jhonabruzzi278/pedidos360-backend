# Referencia de variables del backend. Spring Boot NO lee este archivo por si solo:
# exportalas en la terminal o en el servicio que ejecuta cada proceso.
FRONTEND_ORIGIN=http://localhost:4200
ORDERS_SERVICE_URL=http://localhost:8081
AUDIT_SERVICE_URL=http://localhost:8082

# --- Nube (perfil por defecto): OBLIGATORIAS, sin valor por defecto ---
# JWT_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# JWT_AUDIENCE=<CLIENT_ID_DE_LA_API o api://<CLIENT_ID_DE_LA_API>>

# --- Solo desarrollo local: SPRING_PROFILES_ACTIVE=local ---
# Sus valores por defecto estan en bff/src/main/resources/application-local.yml. El BFF escucha solo en 127.0.0.1.
# NUNCA activar el perfil local en nube: el endpoint /dev/token emite tokens sin autenticar.
# SPRING_PROFILES_ACTIVE=local
# Opcional (minimo 32 bytes). Si falta, se genera una clave aleatoria en cada arranque y los
# tokens emitidos dejan de valer al reiniciar el BFF (hay que volver a iniciar sesion).
# JWT_LOCAL_SECRET=<minimo 32 bytes>
