#!/bin/bash
# user_data de la instancia del backend Pedidos360: instala Java 17, crea un servicio systemd por
# microservicio y un script de despliegue que descarga los JAR desde S3. Se ejecuta al crear la instancia.
set -euxo pipefail
exec > >(tee /var/log/pedidos360-user-data.log) 2>&1

dnf install -y java-17-amazon-corretto-headless nginx

id pedidos360 >/dev/null 2>&1 || useradd --system --home-dir /opt/pedidos360 --shell /sbin/nologin pedidos360
install -d -o pedidos360 -g pedidos360 /opt/pedidos360
install -d /etc/pedidos360

# --- Configuracion (nada secreto: issuer y audience son publicos) ---
cat > /etc/pedidos360/bff.env <<'EOF'
FRONTEND_ORIGIN=${frontend_origin}
ORDERS_SERVICE_URL=http://127.0.0.1:8081
AUDIT_SERVICE_URL=http://127.0.0.1:8082
JWT_ISSUER=${jwt_issuer}
JWT_AUDIENCE=${jwt_audience}
EOF

# Los microservicios internos no autentican: solo escuchan en loopback y el BFF es su unico cliente.
# Usan la base de datos RDS (perfil "rds"). La contrasena NO va aqui: deploy.sh la escribe en
# /etc/pedidos360/db-secret.env leyendola de SSM. sslmode=require: RDS PostgreSQL 15+ obliga a SSL.
for svc in orders-service audit-service; do
  cat > /etc/pedidos360/$svc.env <<EOF
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=rds
DB_URL=jdbc:postgresql://${db_host}:${db_port}/${db_name}?sslmode=require
DB_USERNAME=${db_username}
EOF
done

%{ if jwt_configured ~}
touch /etc/pedidos360/bff.configured
%{ else ~}
echo "JWT sin configurar: el BFF no se inicia hasta definir jwt_issuer y jwt_audience y recrear la instancia"
%{ endif ~}

# --- Un servicio systemd por modulo ---
for svc in orders-service audit-service bff; do
  extra=""
  dbenv=""
  if [ "$svc" = bff ]; then
    extra="ConditionPathExists=/etc/pedidos360/bff.configured"
  else
    dbenv="EnvironmentFile=/etc/pedidos360/db-secret.env"
  fi
  cat > /etc/systemd/system/pedidos360-$svc.service <<UNIT
[Unit]
Description=Pedidos360 $svc
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/pedidos360/$svc.jar
$extra

[Service]
User=pedidos360
EnvironmentFile=/etc/pedidos360/$svc.env
$dbenv
Environment="JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m"
ExecStart=/usr/bin/java -jar /opt/pedidos360/$svc.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
UNIT
done

# --- Script de despliegue: lo usan el arranque de la instancia y el workflow backend-deploy (via SSM) ---
cat > /opt/pedidos360/deploy.sh <<'DEPLOY'
#!/bin/bash
# Uso: deploy.sh [release]   (por defecto "latest"). Descarga los JAR de S3, reinicia y verifica los servicios.
set -euo pipefail
BUCKET="${artifacts_bucket}"
REGION="${region}"
RELEASE="$${1:-latest}"
SRC="s3://$BUCKET/releases/$RELEASE"

# Se captura el listado antes de filtrarlo: "aws s3 ls | grep -q" con pipefail falla por SIGPIPE cuando
# grep cierra la tuberia, y el script creia que no habia artefactos aunque estuvieran.
LISTING="$(aws s3 ls "$SRC/" --region "$REGION" || true)"
if ! grep -q '\.jar' <<<"$LISTING"; then
  if [ "$RELEASE" = "latest" ]; then
    echo "Sin artefactos en $SRC: nada que desplegar"
    exit 0
  fi
  echo "No hay artefactos en $SRC" >&2
  exit 1
fi

# La contrasena de la base sale de SSM (SecureString): no esta en user_data ni en el repositorio. El archivo
# lo lee systemd como root, asi que basta el modo 600.
if ! DB_PASSWORD="$(aws ssm get-parameter --name "${db_password_parameter}" --with-decryption \
    --query Parameter.Value --output text --region "$REGION")" || [ -z "$DB_PASSWORD" ]; then
  echo "No se pudo leer ${db_password_parameter} de SSM: LabInstanceProfile necesita ssm:GetParameter y kms:Decrypt" >&2
  exit 1
fi
( umask 077; printf 'DB_PASSWORD=%s\n' "$DB_PASSWORD" > /etc/pedidos360/db-secret.env )
unset DB_PASSWORD

for svc in orders-service audit-service bff; do
  aws s3 cp "$SRC/$svc.jar" "/opt/pedidos360/$svc.jar.new" --region "$REGION" --only-show-errors
  chown pedidos360:pedidos360 "/opt/pedidos360/$svc.jar.new"
  mv -f "/opt/pedidos360/$svc.jar.new" "/opt/pedidos360/$svc.jar"
done

systemctl daemon-reload
for svc in orders-service audit-service bff; do
  systemctl enable "pedidos360-$svc" >/dev/null 2>&1
  systemctl restart "pedidos360-$svc" || true
done

if [ ! -f /etc/pedidos360/bff.configured ]; then
  echo "JAR desplegados, pero el BFF no se inicia: falta configurar JWT_ISSUER y JWT_AUDIENCE"
  exit 0
fi

for port in 8081 8082 8080; do
  ok=0
  for _ in $(seq 1 60); do
    if curl -fsS "http://127.0.0.1:$port/actuator/health" | grep -q '"UP"'; then ok=1; break; fi
    sleep 2
  done
  if [ "$ok" -ne 1 ]; then
    echo "El servicio del puerto $port no respondio UP" >&2
    journalctl -u "pedidos360-bff" -n 40 --no-pager >&2 || true
    exit 1
  fi
  echo "Puerto $port: UP"
done
echo "Despliegue $RELEASE completado"
DEPLOY
chmod 750 /opt/pedidos360/deploy.sh

# --- Frontend: nginx sirve el sitio Angular; lo publica el workflow frontend (via SSM) ---
install -d -o nginx -g nginx /var/www/pedidos360

cat > /etc/nginx/security-headers.conf <<'NGINX'
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
NGINX

cat > /etc/nginx/nginx.conf <<'NGINX'
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /run/nginx.pid;

events { worker_connections 512; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  sendfile on;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  access_log /var/log/nginx/access.log;

  server {
    listen 80 default_server;
    server_name _;
    root /var/www/pedidos360;
    index index.html;

    # index.html se revalida siempre; los archivos con hash en el nombre se cachean un ano.
    location = /index.html {
      include /etc/nginx/security-headers.conf;
      add_header Cache-Control "no-cache" always;
    }
    location ~* \.(?:js|css|woff2?|svg|png|jpe?g|ico)$ {
      include /etc/nginx/security-headers.conf;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
      try_files $uri =404;
    }
    # SPA: cualquier ruta de Angular devuelve index.html.
    location / {
      include /etc/nginx/security-headers.conf;
      add_header Cache-Control "no-cache" always;
      try_files $uri $uri/ /index.html;
    }
  }
}
NGINX

nginx -t
systemctl enable --now nginx

cat > /opt/pedidos360/deploy-frontend.sh <<'DEPLOYWEB'
#!/bin/bash
# Uso: deploy-frontend.sh [release]   (por defecto "latest"). Publica en nginx el sitio Angular guardado en S3.
set -euo pipefail
BUCKET="${artifacts_bucket}"
REGION="${region}"
RELEASE="$${1:-latest}"
SRC="s3://$BUCKET/frontend/$RELEASE/site.tar.gz"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

if ! aws s3 ls "$SRC" --region "$REGION" >/dev/null 2>&1; then
  if [ "$RELEASE" = "latest" ]; then
    echo "Sin sitio en $SRC: nada que desplegar"
    exit 0
  fi
  echo "No hay sitio en $SRC" >&2
  exit 1
fi

aws s3 cp "$SRC" "$WORK/site.tar.gz" --region "$REGION" --only-show-errors
mkdir "$WORK/site"
tar -xzf "$WORK/site.tar.gz" -C "$WORK/site"
if [ ! -f "$WORK/site/index.html" ]; then
  echo "El paquete no contiene index.html" >&2
  exit 1
fi

chown -R nginx:nginx "$WORK/site"
chmod 755 "$WORK/site"
rm -rf /var/www/pedidos360.old
if [ -d /var/www/pedidos360 ]; then mv /var/www/pedidos360 /var/www/pedidos360.old; fi
mv "$WORK/site" /var/www/pedidos360
rm -rf /var/www/pedidos360.old

curl -fsS -o /dev/null http://127.0.0.1/
echo "Frontend $RELEASE publicado"
DEPLOYWEB
chmod 750 /opt/pedidos360/deploy-frontend.sh

/opt/pedidos360/deploy.sh latest || echo "Despliegue inicial omitido; ejecute el workflow backend"
/opt/pedidos360/deploy-frontend.sh latest || echo "Despliegue inicial del frontend omitido; ejecute el workflow frontend"
